<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/webViewRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Virtual mouse cursor, hidden by default (D-pad mode is the default). -->
    <ImageView
        android:id="@+id/cursorOverlay"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="top|start"
        android:src="@drawable/cursor"
        android:visibility="gone"
        android:elevation="20dp" />

    <!-- Small transient badge announcing the current control mode. -->
    <TextView
        android:id="@+id/modeBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="24dp"
        android:background="@drawable/badge_background"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="Mode: D-Pad"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:visibility="gone"
        android:elevation="21dp" />

</FrameLayout>
